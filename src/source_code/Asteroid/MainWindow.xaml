<Window x:Class="Asteroid.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:Asteroid"
		mc:Ignorable="d"
		Title="ASTEROID" Height="620" Width="1024" Cursor="Cross" WindowStartupLocation="CenterScreen" PreviewKeyDown="canvas_KeyDown" PreviewKeyUp="canvas_KeyUp" ResizeMode="NoResize" WindowStyle="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" Icon="Images/cyanShip.jpg" WindowState="Maximized" Background="Black">
    <Window.Resources>
		<Style x:Key="Title" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="/Asteroid;component/Fonts/#AR DESTINE"/>
			<Setter Property="FontSize" Value="144"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="LightGray"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
		</Style>
		<Style x:Key="Button" TargetType="TextBlock">
			<EventSetter Event="MouseEnter" Handler="MouseEnter"/>
			<EventSetter Event="MouseLeave" Handler="MouseLeave"/>
			<EventSetter Event="MouseDown" Handler="MouseDown"/>
			<Setter Property="FontFamily" Value="/Asteroid;component/Fonts/#AR DESTINE"/>
			<Setter Property="FontSize" Value="48"/>
			<Setter Property="Foreground" Value="Gray"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="Control" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="/Asteroid;component/Fonts/#AR DESTINE"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="Foreground" Value="Gray"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
	</Window.Resources>
	<Grid Name="MainGrid" ScrollViewer.CanContentScroll="True">
		<StackPanel Name="Main_Menu" Margin="0,30,0,0" Visibility="Visible" CanVerticallyScroll="True" ScrollViewer.CanContentScroll="True" ClipToBounds="True">
            <TextBlock Style="{StaticResource Title}" Text="ASTEROID"/>
            <TextBlock Style="{StaticResource Button}" Name="Main_Menu_Game"		MouseLeftButtonUp="Game_MouseUp"			Text="PLAY" Margin="0,75,0,0"/>
			<TextBlock Style="{StaticResource Button}" Name="Main_Menu_Controls"	MouseLeftButtonUp="Controls_MouseUp"		Text="CONTROLS" />
			<TextBlock Style="{StaticResource Button}" Name="Main_Menu_Quit"		MouseLeftButtonUp="Quit_MouseUp"			Text="QUIT" />
		</StackPanel>

		<StackPanel Name="Pause_Menu" Margin="0,30" Visibility="Hidden" CanVerticallyScroll="True" ScrollViewer.CanContentScroll="True" ClipToBounds="True">
            <TextBlock Style="{StaticResource Title}" Text="PAUSE MENU"/>
            <TextBlock Style="{StaticResource Button}" Name="Pause_Menu_Resume"		MouseLeftButtonUp="Resume_MouseUp"		Text="RESUME" Margin="0,75,0,0"/>
			<TextBlock Style="{StaticResource Button}" Name="Pause_Menu_Quit"		MouseLeftButtonUp="Quit_To_Menu_MouseUp"	Text="QUIT TO MAIN MENU"/>
			<TextBlock Style="{StaticResource Button}" Name="Pause_Menu_Quit_Game"	MouseLeftButtonUp="Quit_MouseUp"			Text="EXIT TO WINDOWS"/>
		</StackPanel>

		<StackPanel Name="Controls" Margin="0,30" Visibility="Hidden" CanVerticallyScroll="True" ScrollViewer.CanContentScroll="True" ClipToBounds="True" Focusable="True">
			<TextBlock Style="{StaticResource Control}" Text="Esc                     Pause" ScrollViewer.CanContentScroll="True"/>
			<TextBlock Style="{StaticResource Control}" Text="W                     Thrust"/>
			<TextBlock Style="{StaticResource Control}" Text="A      Rotate Counter-Clockwise"/>
			<TextBlock Style="{StaticResource Control}" Text="D             Rotate Clockwise"/>
			<TextBlock Style="{StaticResource Control}" Text="S                       Warp"/>
			<TextBlock Style="{StaticResource Control}" Text="Space                    Fire"/>
			<TextBlock Style="{StaticResource Button}" Name="Controls_Back"			MouseLeftButtonUp="Controls_Back_MouseUp"	Text="BACK"/>
		</StackPanel>
		
		<Canvas Name="canvas"/>

		<Grid Name="GameHUD" Visibility="Hidden" Width="420" Height="60" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True">
			<TextBlock Text="0"     Foreground="Gray" HorizontalAlignment="Center"		Margin="0,-3,0,0"	FontSize="36" Name="Score" TextAlignment="Center" FontFamily="Segoe UI Semibold"/>
			<TextBlock Text="SCORE" Foreground="Gray" HorizontalAlignment="Center"		Margin="0,36,0,0"	FontSize="16"/>
			<TextBlock Text="3"     Foreground="Gray" HorizontalAlignment="Left"		Margin="82,-3,0,0"	FontSize="24" Name="Lives" TextAlignment="Center" Width="27"/>
			<TextBlock Text="LIVES" Foreground="Gray" HorizontalAlignment="Center"		Margin="48,10,344,0"/>
		</Grid>
	</Grid>
</Window>